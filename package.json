{
  "name": "tmux-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Low-bandwidth multi-session web UI for agent TUIs (Claude Code, Codex) running in tmux",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "mermaid": "^11.17.2",
    "preact": "^11.0.0",
    "typescript": "^7.0.2"
  }
}
